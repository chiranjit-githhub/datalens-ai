# --- LLM provider selection: "anthropic" | "openai" | "ollama" | "none" ---
DATALENS_LLM_PROVIDER=ollama

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (optional alternative provider) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Ollama (optional local/offline provider — no API key needed) ---
# Requires Ollama running locally (https://ollama.com) with a tool-calling
# capable model pulled, e.g.: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Data ---
# Path to the raw transactions CSV (defaults to data/raw/transactions.csv)
DATALENS_RAW_CSV=data/raw/transactions.csv

# --- Agent tunables ---
DATALENS_MAX_STEPS=5

# --- Anomaly detection tunables ---
DATALENS_Z_THRESHOLD=3.0
DATALENS_IQR_MULT=1.5
DATALENS_IF_CONTAMINATION=0.01
DATALENS_LARGE_AMOUNT_MULT=3.0

# --- Performance ---
DATALENS_DUCKDB_THRESHOLD=200000
